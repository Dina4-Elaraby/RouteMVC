@model ResetPasswordViewModel
@{
    ViewData["Title"] = "ReseetPassword";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}
<div class="auth-container">
    <form asp-action="ResetPassword" method="post">

        <input asp-for="NewPassword" placeholder="New Password" />
        <span asp-validation-for="NewPassword" class="text-dark"></span>
         <input asp-for="ConfirmNewPassword" placeholder="Confirm New Password" />
        <span asp-validation-for="ConfirmNewPassword" class="text-dark"></span>

        <div>
            <button type="submit">Change Password</button>
        </div>
    </form>
    
</div>
