@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="auth-container">
    <form asp-action="SendResetPasswordLink" method="post">
        <div asp-validation-summary="All"></div>
        <input asp-for="Email" placeholder="Enter your Email" />
        <span asp-validation-for="Email" class="text-danger"></span>

      
        <button type="submit">Send reset password</button>
    </form>
    
      <div class="link">
        Remember your password? <a asp-action="Login"> Cancel</a>
    </div>
</div>
