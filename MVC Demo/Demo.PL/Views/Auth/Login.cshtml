@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="auth-container">

        <h2>Login</h2>

        <form asp-action="Login" asp-controller="Auth" method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <input asp-for="Email" placeholder="Email Address">
            <span asp-validation-for="Email" class="text-danger"></span>

            <input asp-for="Password" placeholder="Password">
            <span asp-validation-for="Password" class="text-danger"></span>

            <div class="wthree-text">
                <label class="anim">
                    <input asp-for="RememberMe" class="checkbox" />
                    <span>Remember Me</span>
                </label>
                <div class="clear"></div>
            </div>
            <button type="submit">Login</button>
        </form>

        <div class="link">
            Don't have an account? <a asp-action="Register">Register</a>
        </div>
    <div class="link">
        Forget Password? <a asp-action="ForgetPassword">Reset password</a>
    </div>
       </div>




