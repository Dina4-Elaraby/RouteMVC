@using Demo.BusinessLogic.Services.Department
@using Demo.Presentation.ViewModels.Employee
@using Demo.DataAccess.Models.EmployeeModel;
@using Demo.DataAccess.Models.CommonModel;
@model EmployeeViewModel
@inject IDepartmentServices deptService
@{
    var depts = new SelectList(deptService.GetAllDepts(), "DeptId", nameof(DepartmentsDTO.Name));
}

<div class="form-group mb-3 col-6">
    <label class="label-form" asp-for="Name">  </label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Age">  </label>
    <input asp-for="Age" class="form-control" />
    <span asp-validation-for="Age" class="text-danger"></span>
</div>

<div class="from-group mb-3 col-6">
    <label class="form-label" asp-for="Address">  </label>
    <input asp-for="Address" class="form-control" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>

<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Salary"> </label>
    <input class="form-control" asp-for="Salary" />
    <span asp-validation-for="Salary" class="text-danger"></span>
</div>

<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Email"> </label>
    <input class="form-control" asp-for="Email" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="PhoneNumber"> </label>
    <input class="form-control" asp-for="PhoneNumber" />
    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
</div>

<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="HiringDate"> </label>
    <input type="date" class="form-control" asp-for="HiringDate" />
    <span asp-validation-for="HiringDate" class="text-danger"></span>
</div>

<div class="form-group mb-3 col-6">
    <input class="form-check-input" asp-for="IsActive" />
    <label class="col-form-label" asp-for="IsActive"> </label>
    <span asp-validation-for="IsActive" class="text-danger"></span>
</div>

<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="EmployeeType"> </label>
    <select class="form-control" asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()">
        <option value="">Choose Employee Type</option>
    </select>
    <span asp-validation-for="EmployeeType" class="text-danger"></span>

</div>

<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Gender"></label>
    <div>
        @foreach (var gender in Enum.GetValues<Gender>())
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Gender" value="@gender" />
                <label class="form-check-label">@gender</label>
            </div>
        }
    </div>
    <span asp-validation-for="Gender" class="text-danger"></span>
</div>

<div class="form-group mb-3 col-6">
<label asp-for="DepartmentId" class="form-label"></label>
    <select class="form-control" asp-for="DepartmentId" asp-items="depts">
    <option value="@null">Choose Department</option>
    </select>
    <span asp-validation-for="DepartmentId" class="text-danger"></span>
</div>

