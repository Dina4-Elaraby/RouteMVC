@model IEnumerable<EmployeesDTO>
@{
    ViewData["Title"] = "Index";
}

<h1>Show All Employees</h1>
<br />
<br />
<a class="btn btn-primary" asp-controller="Employee" asp-action="Create">Add new Employee</a>
<br />
@if (Model.Any())
{
    <table class="table table-striped table-hover mt-3">
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(e => e.Name)</th>
                <th>@Html.DisplayNameFor(e => e.Age)</th>
                <th>@Html.DisplayNameFor(e => e.Email)</th>
                <th>@Html.DisplayNameFor(e => e.Salary)</th>
                <th>@Html.DisplayNameFor(e => e.Gender)</th>
                <th>@Html.DisplayNameFor(e => e.IsActive)</th>
                <th>@Html.DisplayNameFor(e => e.EmployeeType)</th>
                <th>Details</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.Name</td>
                    <td>@emp.Age</td>
                    <td>@emp.Email</td>
                    <td>@Html.DisplayFor(e => emp.Salary)</td> @*TO print as currency*@
                    <td>@emp.Gender</td>
                    <td><i class="fa @(emp.IsActive ?"fa-solid fa-circle-check text-success":"fa-times-circle text-danger")"></i> </td>
                    <td>@emp.EmployeeType</td>
                    <td>
                        <a class="btn btn-primary" asp-action="Details" asp-route-Id="@emp.Id">
                            <i class="fas fa-eye"></i>Details
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-success" asp-action="Edit" asp-route-Id="@emp.Id">
                            <i class="fas fa-edit"></i>Edit
                        </a>    
                    </td>
                    <td>
                        @* <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@dept.DeptId"> <i class="fas fa-trash"></i> Delete</a> *@

                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteModal-@emp.Id">
                            @*dynamic for each dept try to delete*@
                            <i class="fas fa-trash"></i> Delete
                        </button>


                        <div class="modal fade" id="DeleteModal-@emp.Id" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Delete @emp.Name Employee</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are You Sure to Delete @emp.Name Employee?
                                    </div>
                                    <div class="modal-footer">
                                        <form asp-action="Delete" asp-controller="Employee" asp-route-id="@emp.Id" class="mt-4">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <input type="submit" value="Delete" class="btn btn-danger" />
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>

    </table>

}
else
{
    <div class="alert alert-info mt-2">
        <h2>No Employee Exist Yet !!</h2>
    </div>
}


