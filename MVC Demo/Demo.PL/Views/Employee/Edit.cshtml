@using Demo.DataAccess.Models.EmployeeModel;
@using Demo.DataAccess.Models.CommonModel;
@using Demo.Presentation.ViewModels.Employee

@model EmployeeViewModel
@{
    ViewData["Title"] = "Edit";
}

<div class="row justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Edit data @Model.Name</h1>
    <form method="post" asp-controller="Employee" asp-action="Edit" class="col-8">

        <partial name="PartialViews/_CreateEditPartialView" />

        <div class=" mt-3 m-auto">
            <input class="btn btn-success" type="submit" value="Edit" />
            <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-dark">Back to list</a>
        </div>

    </form>
</div>


