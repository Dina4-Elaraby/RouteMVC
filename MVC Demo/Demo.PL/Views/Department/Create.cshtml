@model DepartementViewModel
@{
    ViewData["Title"] = "Create";
}

<div class="row justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Create a new department</h1>
    <form class="col-8" method="post" asp-action="Create">
        @* => when click submit go to action(create) type=>post*@
       
        <partial name="PartialView/_CreateEditPartialView"/>

        <div class="mt-4 m-auto">
            <input class="btn btn-primary" type="submit" value="Create" /> @* type=>must be submit to send data,but value can change*@
            <a class="btn btn-outline-dark" asp-action="Index">Back to Departments</a>
        </div>

    </form>
</div>

@section ClientValidation
{
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}